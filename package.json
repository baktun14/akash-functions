{
  "name": "akash-functions",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run dev:stop",
    "dev": "concurrently --kill-others-on-fail --names server,web --prefix-colors blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev:stop": "pids=$(lsof -iTCP:8081 -iTCP:5173 -iTCP:5174 -sTCP:LISTEN -t 2>/dev/null); if [ -n \"$pids\" ]; then echo \"$pids\" | xargs kill 2>/dev/null; sleep 1; pids=$(lsof -iTCP:8081 -iTCP:5173 -iTCP:5174 -sTCP:LISTEN -t 2>/dev/null); [ -n \"$pids\" ] && echo \"$pids\" | xargs kill -9 2>/dev/null; fi; true",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "web": "npm run dev -w web",
    "server": "npm run dev -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
