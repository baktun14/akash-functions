{
  "name": "server",
  "version": "1.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "claim-orphans": "tsx scripts/claim-orphans.ts",
    "backfill-variables": "tsx scripts/backfill-variables.ts",
    "deploy-prod": "tsx scripts/deploy-prod.ts",
    "rebind-prod": "tsx scripts/rebind-prod.ts",
    "restore-closed-by-probe": "tsx scripts/restore-closed-by-probe.ts"
  },
  "dependencies": {
    "@akash-functions/shared": "*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.10",
    "js-yaml": "^4.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
