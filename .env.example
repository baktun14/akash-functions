# Backend (packages/server)
PORT=8081
DATABASE_URL=postgres://baktun14@localhost:5433/akash_functions
AKASH_API_BASE=https://console-api.akash.network/v1
# `:latest` is auto-resolved at SDL build time to the most recent runner-v*
# GitHub release (Akash rejects floating tags). Pin explicitly (e.g. :2.0.1)
# to opt out and lock to a specific version.
RUNNER_IMAGE=ghcr.io/baktun14/akash-functions-runner:latest
CODE_SIGNING_SECRET=change-me-to-a-32-byte-random-string
# Must be reachable from Akash provider containers. For local dev:
#   cloudflared tunnel --url http://localhost:8081
# Then paste the public HTTPS URL here. Tunnel must stay up while a deployment is live.
CODE_HOST_BASE=http://host.docker.internal:8081
DEPLOY_DEPOSIT=5
DEPLOY_PRICING_AMOUNT=1000

# Frontend (packages/web)
VITE_API_BASE=http://localhost:8081
# 'live' hits the real backend + Akash. 'mock' is offline localStorage-only.
VITE_API_MODE=live
